FROM jenkins/jenkins:lts
USER root

# 젠킨스 컨테이너 내부에 docker CLI 및 Java JDK 설치
RUN apt-get update && \
    apt-get install -y docker.io openjdk-21-jdk && \
    rm -rf /var/lib/apt/lists/*

ENV ANDROID_HOME=/opt/android-sdk

# Android SDK 라이선스 승인
RUN mkdir -p /opt/android-sdk/licenses && \
    printf "84831b9409646a918e30573bab4c9c91346d8abd\n24333f8a63b6825ea9c5514f83c2829b004d1fee\nd56f5187479451eabf01fb78af6dfcb131a6481e\n263b442a90eed9973d995701a074f7373681a471\n7a88798099d002a41280c72ee64571601738b076\n" > /opt/android-sdk/licenses/android-sdk-license && \
    printf "84831b9409646a918e30573bab4c9c91346d8abd\n504667f4c05e7d9a562e323e47f942612c70f000\n" > /opt/android-sdk/licenses/android-sdk-preview-license && \
    chown -R jenkins:jenkins /opt/android-sdk
